{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:release": "node --test tests/release-source.test.mjs",
    "release:check": "node scripts/check-pilot-source.mjs",
    "release:pilot": "node scripts/publish-pilot-update.mjs",
    "preview:web": "node scripts/preview-pilot-web.mjs",
    "preview:pilot2": "node scripts/preview-pilot-web.mjs --pilot2"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
