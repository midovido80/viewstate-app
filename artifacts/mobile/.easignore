# EAS source input must contain product source only.
.git/
.github/
.agents/
.local/
.cache/
.expo/
.expo-shared/
.replit
.replitignore
**/.replit-artifact/
**/node_modules/
**/dist/
**/web-build/
**/static-build/
**/test-output/
**/coverage/

# Local secrets, credentials, and databases.
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.pem
**/*.key
**/*.mobileprovision

# Unrelated workspace assets and local release output.
attached_assets/
**/attached_assets/
**/*.apk
**/*.aab
**/*.ipa
**/*.xcarchive/